{
  "yaml.schemas": {
    "https://github.boki.moe/https://raw.githubusercontent.com/dongchengjie/meta-json-schema/main/schemas/meta-json-schema.json": [
      "config/clash/**/*.{yaml,yml}"
    ]
  },

  "json.schemas": [
    {
      "fileMatch": ["config/singbox/**/*.json"],
      // "url": "https://gist.githubusercontent.com/malikshi/a13ba46d42a26975002e4dd4747a434b/raw/sing-box.schema.json"
      // "url": "https://kenxx.github.io/sing-box.json/sing-box-config-schema.json"
      "url": "https://unpkg.com/@black-duty/sing-box-schema@latest/schema.zh.json"
      // "url": "https://unpkg.com/@black-duty/sing-box-schema@1.13.0/schema.zh.json"
      // "url": "https://artiga033.github.io/sing-box-schema/config.schema.json"
    }
  ],
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true
  },

  "editor.defaultFormatter": "oxc.oxc-vscode",
  "[dotenv]": {
    "editor.defaultFormatter": "xqvvu.shell-tidy-vscode"
  }

  // "editor.defaultFormatter": "biomejs.biome"
  // "editor.defaultFormatter": "denoland.vscode-deno"
}
