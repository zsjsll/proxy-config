{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "perf": "warn",
    "suspicious": "warn",
    "pedantic": "warn",
    // "restriction": "warn"
    // "style": "warn"
    // "nursery": "warn"
  },
  "rules": {
    "capitalized-comments": "off",
  },
  "env": {
    "builtin": true,
  },
}
