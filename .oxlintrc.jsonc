{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "warn",
    "perf": "warn",
    "suspicious": "warn",
    "pedantic": "warn",
    "style": "warn",
    // "restriction": "warn",
    // "nursery": "warn"
  },
  "rules": {
    "no-inline-comments": "off",
    "prefer-const": "warn",
    "no-ternary": "off",
    "id-length": "off",
    "curly": "off",
    "max-statements": "off",
    "no-magic-numbers": "off",
    "no-continue": "off",
    "sort-keys": "off",
    "capitalized-comments": "off",
    "numeric-separators-style": "off",
    "sort-imports": "off",
  },
  "env": {
    "builtin": true,
  },
  "ignorePatterns": ["script/@types"],
}
